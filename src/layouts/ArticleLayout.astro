---
import BaseLayout from './BaseLayout.astro';
import { isoDate } from '../lib/meta';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  minutes?: string;
}
const { title, description, pubDate, tags = [], minutes } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <article class="prose">
    <p class="mono">
      <time datetime={pubDate.toISOString()}>{isoDate(pubDate)}</time>
      {minutes && <span> · {minutes}</span>}
      {tags.length > 0 && <span> · {tags.join(', ')}</span>}
    </p>
    <h1 style="font-size:clamp(34px,5vw,52px)">{title}</h1>
    <slot />
  </article>
</BaseLayout>
