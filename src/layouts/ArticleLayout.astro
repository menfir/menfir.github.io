---
import BaseLayout from './BaseLayout.astro';
import { isoDate } from '../lib/meta';
import { AUTHOR } from '../lib/site';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  minutes?: string;
}
const { title, description, pubDate, tags = [], minutes } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: isoDate(pubDate),
  url: new URL(Astro.url.pathname, Astro.site).href,
  author: { '@type': 'Person', name: AUTHOR },
  ...(tags.length > 0 && { keywords: tags.join(', ') }),
};
---
<BaseLayout title={title} description={description} ogType="article">
  <article class="prose">
    <p class="mono">
      <time datetime={pubDate.toISOString()}>{isoDate(pubDate)}</time>
      {minutes && <span> · {minutes}</span>}
      {tags.length > 0 && <span> · {tags.join(', ')}</span>}
    </p>
    <h1 style="font-size:clamp(34px,5vw,52px)">{title}</h1>
    <slot />
  </article>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
