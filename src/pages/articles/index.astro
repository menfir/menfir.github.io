---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Articles" description="Everything written here, newest first.">
  <h1>Articles</h1>
  <ul class="entry-list">
    {articles.map((a) => (
      <li>
        <h3><a href={`/articles/${a.id}`}>{a.data.title}</a></h3>
        <time datetime={a.data.pubDate.toISOString()}>
          {a.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        <p>{a.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
