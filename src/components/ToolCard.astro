---
interface Props {
  id: string;
  name: string;
  description: string;
  dot: string;
}
const { id, name, description, dot } = Astro.props;
---
<a class="tool-card" href={`/tools/${id}`}>
  <span class="tool-name">
    <span class="dot" style={`background:${dot}`}></span>
    {name}
  </span>
  <span class="tool-desc">{description}</span>
</a>
